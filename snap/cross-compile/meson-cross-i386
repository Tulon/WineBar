[binaries]
c = 'i686-linux-gnu-gcc'
cpp = 'i686-linux-gnu-g++'
ar = 'i686-linux-gnu-gcc-ar'
strip = 'i686-linux-gnu-strip'
pkg-config = 'i686-linux-gnu-pkg-config'
cmake = 'cmake'
rust = ['rustc', '--target', 'i686-unknown-linux-gnu']
rust_ld = 'i686-linux-gnu-gcc'

[cmake]
CMAKE_C_COMPILER    = 'i686-linux-gnu-gcc'
CMAKE_CXX_COMPILER  = 'i686-linux-gnu-g++'

[paths]
libdir = 'lib/i386-linux-gnu'

[host_machine]
system = 'linux'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'
